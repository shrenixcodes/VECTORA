# VECTORA local engine configuration. Copy to .env or set in your shell.
# All values are optional; defaults are shown.

# Loopback address and port of the local engine.
VECTORA_HOST=127.0.0.1
VECTORA_PORT=4317

# Where VECTORA keeps its database, imported sources and caches.
# Default: .vectora-data inside the VECTORA folder (uploads and temp files live here too).
# VECTORA_DATA_DIR=

# Extra allowed browser origins (comma separated). The engine only accepts
# same-origin requests plus the Vite dev server by default.
# VECTORA_ALLOWED_ORIGINS=http://localhost:5173

# Log level: fatal | error | warn | info | debug
VECTORA_LOG_LEVEL=info

# Python interpreter used for Python source analysis.
# VECTORA_PYTHON=python
